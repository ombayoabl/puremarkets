{
    // The name must match the project name in Cloudflare (Workers & Pages).
    "name": "puremarkets-site",
    "main": "worker/index.js",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // the site is a single-page app: any page URL opens index.html
        "not_found_handling": "single-page-application",
        // only the back end runs code; the site files are served directly
        "run_worker_first": ["/api/*"]
    }
}
